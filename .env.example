# Leave DATABASE_URL empty to use the persistent local demonstration store.
DATABASE_URL=
# Example: postgresql://clinic:change-this-password@localhost:5432/clinic
# Required in production; generate a random secret of at least 32 characters.
SESSION_SECRET=
# Development seed accounts only. Never enable on a public production server.
DEMO_MODE=true

# Public hosting: DEMO_MODE=false and a separate PostgreSQL database.
# Hosting bootstrap creates one administrator on the first start only.
# ADMIN_USERNAME=admin
# ADMIN_NAME=Quan tri vien
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
