# Current runtime: React/Vite + Windows PowerShell + SQL Server.
# Copy to .env.local; protect the file with OS permissions. Never commit secrets.
MEDICARE_SQL_CONNECTION=Server=.\SQLEXPRESS;Database=QuanLyBenhVien;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=5
ADMIN_USERNAME=admin
ADMIN_NAME=Quan tri vien
ADMIN_EMAIL=
# Required only by npm run admin:init; 12-128 characters, no default password.
ADMIN_PASSWORD=
HOST=127.0.0.1
PORT=5180
# Public deployment: set NODE_ENV=production and the exact external HTTPS origin.
# MEDICARE_PUBLIC_ORIGIN=https://clinic.example
# MEDICARE_ALLOW_HTTP=true is only for a private loopback demonstration.
# Tests always create a new database; this base string must NOT include Database=.
# MEDICARE_TEST_SQL_BASE=Server=.\SQLEXPRESS;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=5
